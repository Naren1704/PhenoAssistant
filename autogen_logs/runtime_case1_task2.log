scription": "num_results"}}, "required": ["query"]}}}, {"type": "function", "function": {"description": "Check available computer vision checkpoints. Must be called before using computer vision models.", "name": "get_model_zoo", "parameters": {"type": "object", "properties": {}, "required": []}}}, {"type": "function", "function": {"description": "Perform instance segmentation on plant images", "name": "infer_instance_segmentation", "parameters": {"type": "object", "properties": {"image_urls": {"anyOf": [{"items": {"type": "string"}, "type": "array"}, {"type": "null"}], "default": null, "description": "List of image paths"}, "file_path": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "description": "Path to CSV/JSON file with a 'file_name' column/key containing image URLs"}, "checkpoint": {"type": "string", "default": null, "description": "Segmentation model checkpoint identifier."}, "batch_size": {"type": "integer", "default": 1, "description": "Number of images to process per batch."}, "device": {"type": "string", "default": "cuda", "description": "Device to use for inference ('cuda' or 'cpu')."}, "output_dir": {"type": "string", "default": "./results", "description": "Directory path to save results."}}, "required": []}}}, {"type": "function", "function": {"description": "Perform image classification on plant images", "name": "infer_image_classification", "parameters": {"type": "object", "properties": {"image_urls": {"anyOf": [{"items": {"type": "string"}, "type": "array"}, {"type": "null"}], "default": null, "description": "List of image paths"}, "file_path": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "description": "Path to CSV/JSON file with a 'file_name' column/key containing image URLs"}, "checkpoint": {"type": "string", "default": null, "description": "Classification model checkpoint identifier."}, "batch_size": {"type": "integer", "default": 1, "description": "Number of images to process per batch."}, "device": {"t