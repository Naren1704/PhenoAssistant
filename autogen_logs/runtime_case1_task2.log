/Case1_Task2_wlog directory, naming them as [phenotype]_plot.png, e.g. pla_plot.png.\nFor each plot:\n- Use shades to represent the standard deviation.\n- Set plot title as \"Mean and STD of [phenotype] for each ecotype over time\".\n- Set x-axis label as \"Days after sowing\".\n- Set y-axis label as \"[phenotype]\".\n- Set legend to show the ecotype names.\n- Do not use grid lines.\n", "role": "user", "name": "Admin"}], "tools": [{"type": "function", "function": {"description": "Perform Mixed-design Repeated Measures ANOVA on given data (Greenhouse-Geisser correction will be automatically applied if needed)", "name": "perform_anova", "parameters": {"type": "object", "properties": {"data_path": {"type": "string", "description": "Path to the input CSV file"}, "descriptor": {"type": "string", "description": "The name of the descriptor column to analyse"}, "within_subject_factor": {"type": "string", "description": "The name of the within-subjects factor"}, "between_subject_factor": {"type": "string", "description": "The name of the between-subjects factor"}, "subject_id": {"type": "string", "description": "The name of the subject identifier"}, "save_path": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "description": "Path to save the ANOVA results CSV"}}, "required": ["data_path", "descriptor", "within_subject_factor", "between_subject_factor", "subject_id"]}}}, {"type": "function", "function": {"description": "Perform Post-hoc Tukey-Kramer test on given data", "name": "perform_tukey_test", "parameters": {"type": "object", "properties": {"data_path": {"type": "string", "description": "Path to the input CSV file"}, "descriptor": {"type": "string", "description": "The name of the descriptor column to analyse"}, "between_subject_factor": {"type": "string", "description": "The name of the between-subjects factor"}, "subject_id": {"type": "string", "description": "The name of the subject identifier"}, "save_path": {"anyOf": [{"type": "string"}, {"type":