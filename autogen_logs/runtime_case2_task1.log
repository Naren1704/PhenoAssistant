 "object", "properties": {"problem": {"type": "string", "description": "The question that can be answered based on knowledge retrieved from external source."}}, "required": ["problem"]}}}, {"type": "function", "function": {"description": "Instruct the user to prepare a dataset in the required format to train a model.", "name": "get_dataset_format", "parameters": {"type": "object", "properties": {"task": {"type": "string", "description": "Type of supported task: 'image-classification', 'instance-segmentation', or 'image-regression'."}}, "required": ["task"]}}}, {"type": "function", "function": {"description": "When the user upload a dataset for model training, use this function to process the dataset into the required format.", "name": "prepare_dataset", "parameters": {"type": "object", "properties": {"dataset_name": {"type": "string", "description": "Name of dataset to be uploaded to HuggingFace."}, "root": {"type": "string", "description": "Root directory where the dataset is stored."}, "task": {"type": "string", "description": "Type of supported task: 'classification', 'instance segmentation', or 'regression'."}}, "required": ["dataset_name", "root", "task"]}}}, {"type": "function", "function": {"description": "Train an image classification model on a user uploaded dataset.", "name": "finetune_image_classification", "parameters": {"type": "object", "properties": {"dataset_name": {"type": "string", "description": "Dataset name for finetuning."}, "ft_method": {"enum": ["lora", "fullft"], "type": "string", "default": "lora", "description": "Finetuning method ('lora' or 'fullft')."}, "train_bs": {"type": "integer", "default": 32, "description": "Training batch size."}, "val_bs": {"type": "integer", "default": 1, "description": "Validation batch size."}, "img_w": {"type": "integer", "default": 512, "description": "Image width for training."}, "img_h": {"type": "integer", "default": 512, "description": "Image height for training."}, "lr": {"type": "number", "default": 0