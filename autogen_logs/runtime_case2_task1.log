sult file", "name": "compute_phenotypes_from_ins_seg", "parameters": {"type": "object", "properties": {"ins_seg_result_path": {"type": "string", "description": "Path to a COCO format JSON file containing instance segmentation results."}, "save_path": {"type": "string", "description": "Path to save the computed phenotypes."}, "pixel_to_cm": {"type": "number", "default": 1.0, "description": "The scale to map pixel values to cm. i.e. number of pixels * pixel_to_cm = cm."}}, "required": ["ins_seg_result_path", "save_path"]}}}, {"type": "function", "function": {"description": "Write and execute code to solve tasks. Please provide a complete task description rather than concrete code as the input to this function.", "name": "coding", "parameters": {"type": "object", "properties": {"message": {"type": "string", "description": "Describe the task to be solved."}, "file_path": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "description": "(Optional) The path to an input csv file."}}, "required": ["message"]}}}, {"type": "function", "function": {"description": "Analyse a plot using GPT-4o.", "name": "analyse_plot", "parameters": {"type": "object", "properties": {"message": {"type": "string", "description": "The request of analysing a plot. e.g. 'what plant yields the most leaves at the end of the experiment?'"}, "file_path": {"type": "string", "description": "The path of the plot to be analysed, including the suffix."}}, "required": ["message", "file_path"]}}}, {"type": "function", "function": {"description": "Compute statistics or new values from a CSV file. Optionally, it saves the results to a new file.", "name": "compute_from_csv", "parameters": {"type": "object", "properties": {"message": {"type": "string", "description": "The request of computing from a CSV file. Example: 'Compute the average of A for B on C.'"}, "file_path": {"type": "string", "description": "The path of the CSV file to be analysed."}, "save_path": {"anyOf": [{"type": "string"}, {"ty