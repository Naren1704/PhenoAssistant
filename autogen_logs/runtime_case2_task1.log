 {"pipeline_name": {"type": "string", "description": "Name of pipeline to be called."}, "kwargs": {"type": "object", "description": "Arguments of the selected pipeline."}}, "required": ["pipeline_name", "kwargs"]}}}, {"type": "function", "function": {"description": "Perform basic arithmetic operations between two integers.", "name": "calculator", "parameters": {"type": "object", "properties": {"a": {"type": "integer", "description": "a"}, "b": {"type": "integer", "description": "b"}, "operator": {"type": "string", "description": "operator"}}, "required": ["a", "b", "operator"]}}}, {"type": "function", "function": {"description": "Search and scrape content from the web. Results are returned in a dictionary. Useful when you need to find information on a specific topic.", "name": "google_search", "parameters": {"type": "object", "properties": {"query": {"type": "string", "description": "query"}, "num_results": {"type": "integer", "default": 10, "description": "num_results"}}, "required": ["query"]}}}, {"type": "function", "function": {"description": "Check available computer vision checkpoints. Must be called before using computer vision models.", "name": "get_model_zoo", "parameters": {"type": "object", "properties": {}, "required": []}}}, {"type": "function", "function": {"description": "Perform instance segmentation on plant images", "name": "infer_instance_segmentation", "parameters": {"type": "object", "properties": {"image_urls": {"anyOf": [{"items": {"type": "string"}, "type": "array"}, {"type": "null"}], "default": null, "description": "List of image paths"}, "file_path": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "description": "Path to CSV/JSON file with a 'file_name' column/key containing image URLs"}, "checkpoint": {"type": "string", "default": null, "description": "Segmentation model checkpoint identifier."}, "batch_size": {"type": "integer", "default": 1, "description": "Number of images to process per batch."}, "device": {"type": 